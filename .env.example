# Copy to .env or export directly.
DEEPSEAPORT_CONFIG=./config.json
DEEPSEAPORT_KEYS=sk-local-dev
DEEPSEAPORT_PORT=5001
# true -> bind 0.0.0.0 (LAN), false/default -> 127.0.0.1
DEEPSEAPORT_LISTEN=
# Single account (alternative to config.json; DEEPSEAPORT_* preferred,
# DEEPSEEK_* kept as aliases)
# DEEPSEAPORT_EMAIL=
# DEEPSEAPORT_PASSWORD=
# DEEPSEAPORT_TOKEN=
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=
DEEPSEEK_TOKEN=
# DEEPSEAPORT_ACTIVE_ACCOUNT=
# Provider selection (alternative to config.json)
# DEEPSEAPORT_PROVIDER=deepseek
# DEEPSEAPORT_PROVIDERS=
# Obscura overrides
OBSCURA_BIN=
OBSCURA_PROFILE=
# Browser / data dir
# DEEPSEAPORT_BROWSER_BIN=auto
# DEEPSEAPORT_BROWSER_HEADLESS=
# DEEPSEAPORT_DATA=./data
# Advanced host overrides (default pinned hosts preserved)
# DEEPSEAPORT_HOST=chat.deepseek.com
# DEEPSEAPORT_BASE=https://chat.deepseek.com
# DEEPSEAPORT_CHAT_HOME=https://chat.deepseek.com/
# DEEPSEAPORT_WASM_URL=
# DEEPSEAPORT_WASM_NAME=
# Qwen overrides
# DEEPSEAPORT_QWEN_HOST=chat.qwen.ai
# DEEPSEAPORT_QWEN_BASE=https://chat.qwen.ai
# DEEPSEAPORT_QWEN_VERSION=0.2.91
# DEEPSEAPORT_QWEN_COMPLETION_VERSION=2.1
# DEEPSEAPORT_QWEN_NO_BEARER=
# Behaviour overrides (mirror config.json; 1/true/yes/on = true)
# DEEPSEAPORT_ENABLE_TOOLS=1
# DEEPSEAPORT_WARMUP_ON_STARTUP=1
# DEEPSEAPORT_AUTO_DELETE_SESSION=1
# DEEPSEAPORT_MAX_RETRIES=1
# DEEPSEAPORT_PARALLEL_FETCH=1
# Tool-call argument cap in characters (default 200000; larger values let
# coders write bigger files in one call, at the cost of more memory).
# DEEPSEAPORT_MAX_ARGS_CHARS=200000
# More forgiving toolcalls: repair common model markup slips (pipe/space/
# HTML-escaped DSML markers, smart attribute delimiters, missing-name/param
# inference for single-tool harnesses, JSON invoke bodies). Default off.
# DEEPSEAPORT_FORGIVING_TOOLCALLS=1
# DEEPSEAPORT_USE_MULTIPLE_ACCOUNTS=1
# DEEPSEAPORT_LOG_LEVEL=INFO
# DEEPSEAPORT_STREAM_MODE=live
# DEEPSEAPORT_CHAT_MODEL=deepseek-flash
# Custom text wrapped around every prompt (multi-line ok; "" disables).
# DEEPSEAPORT_ENABLE_APPEND=1
# DEEPSEAPORT_APPEND_TOP=
# DEEPSEAPORT_APPEND_BOTTOM=
# Dry run echo carries the printed raw + formatted prompt (1/true/yes/on)
# DEEPSEAPORT_SEND_DRY_RUN_TO_FRONTEND=1
