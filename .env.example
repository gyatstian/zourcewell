# Copy to .env or export directly.
#
# WARNING: every DEEPSEAPORT_* var below is commented out ON PURPOSE. Per
# config.py an env var with a real value overrides config.json, so an
# uncommented DEEPSEAPORT_KEYS silently replaces your keys,
# DEEPSEAPORT_PORT forces the port, and DEEPSEAPORT_LISTEN forces the bind.
# Uncomment only the ones you mean.
# DEEPSEAPORT_CONFIG=./config.json
# API key(s), comma separated; replaces config.json "keys". Leave it empty
# (or absent) to keep the config's keys; a list that parses to nothing is
# ignored with a warning. `"keys": []` in config.json means AUTH DISABLED on
# every endpoint.
# DEEPSEAPORT_KEYS=sk-change-me
# DEEPSEAPORT_PORT=5001
# true -> bind 0.0.0.0 (LAN-visible; the server prints a warning), false ->
# 127.0.0.1 only; unset -> config.json decides.
# DEEPSEAPORT_LISTEN=
# Single account (alternative to config.json; DEEPSEAPORT_* preferred,
# DEEPSEEK_* kept as aliases)
# DEEPSEAPORT_EMAIL=
# DEEPSEAPORT_PASSWORD=
# DEEPSEAPORT_TOKEN=
# DEEPSEEK_EMAIL=
# DEEPSEEK_PASSWORD=
# DEEPSEEK_TOKEN=
# DEEPSEAPORT_ACTIVE_ACCOUNT=
# Provider selection (alternative to config.json)
# DEEPSEAPORT_PROVIDER=deepseek
# DEEPSEAPORT_PROVIDERS=
# Obscura overrides: a real path overrides config.json, an empty value
# (`OBSCURA_BIN=`) counts as unset and keeps the config.json value.
# OBSCURA_BIN=
# OBSCURA_PROFILE=
# Browser / data dir
# DEEPSEAPORT_BROWSER_BIN=auto
# DEEPSEAPORT_BROWSER_HEADLESS=
# DEEPSEAPORT_DATA=./data
# Advanced host overrides (default pinned hosts preserved)
# DEEPSEAPORT_HOST=chat.deepseek.com
# DEEPSEAPORT_BASE=https://chat.deepseek.com
# DEEPSEAPORT_CHAT_HOME=https://chat.deepseek.com/
# DEEPSEAPORT_WASM_URL=
# DEEPSEAPORT_WASM_NAME=
# Qwen overrides
# DEEPSEAPORT_QWEN_HOST=chat.qwen.ai
# DEEPSEAPORT_QWEN_BASE=https://chat.qwen.ai
# DEEPSEAPORT_QWEN_VERSION=0.2.91
# DEEPSEAPORT_QWEN_COMPLETION_VERSION=2.1
# DEEPSEAPORT_QWEN_NO_BEARER=
# Behaviour overrides (mirror config.json; 1/true/yes/on = true)
# DEEPSEAPORT_ENABLE_TOOLS=1
# DEEPSEAPORT_WARMUP_ON_STARTUP=1
# DEEPSEAPORT_AUTO_DELETE_SESSION=1
# DEEPSEAPORT_MAX_RETRIES=1
# DEEPSEAPORT_PARALLEL_FETCH=1
# Tool-call argument cap in characters (default 200000; larger values let
# coders write bigger files in one call, at the cost of more memory).
# DEEPSEAPORT_MAX_ARGS_CHARS=200000
# More forgiving toolcalls: repair common model markup slips (pipe/space/
# HTML-escaped DSML markers, smart attribute delimiters, missing-name/param
# inference for single-tool harnesses, JSON invoke bodies). Default off.
# DEEPSEAPORT_FORGIVING_TOOLCALLS=1
# Cap on JSON objects the tool parser scans for a bare name+arguments call
# (default 40; also bounds the forgiving bucket's total-call scan).
# DEEPSEAPORT_MAX_BARE_OBJECTS=40
# DEEPSEAPORT_USE_MULTIPLE_ACCOUNTS=1
# DEEPSEAPORT_LOG_LEVEL=INFO
# DEEPSEAPORT_STREAM_MODE=live
# DEEPSEAPORT_CHAT_MODEL=deepseek-flash
# Custom text wrapped around every prompt (multi-line ok; "" disables).
# DEEPSEAPORT_ENABLE_APPEND=1
# DEEPSEAPORT_APPEND_TOP=
# DEEPSEAPORT_APPEND_BOTTOM=
# Dry run echo carries the printed raw + formatted prompt (1/true/yes/on)
# DEEPSEAPORT_SEND_DRY_RUN_TO_FRONTEND=1
# --- opencode (local CLI) provider: no account, no token, no WAF ---
# Serve base URL. Unset = boot/reuse a managed isolated `opencode serve`;
# set it to use your own instance as-is (this also opts out of the managed boot).
# DEEPSEAPORT_OPENCODE_BASE=http://127.0.0.1:4096
# Session working directory for tool execution (sent as location.directory in
# the session create body); unset = the deepseaport process cwd. Set it when
# the harness runs elsewhere.
# DEEPSEAPORT_OPENCODE_WORKDIR=
# HTTP basic auth against the serve instance (managed child gets an
# ephemeral password of its own). Username default opencode, password "".
# DEEPSEAPORT_OPENCODE_USERNAME=opencode
# DEEPSEAPORT_OPENCODE_PASSWORD=
# 0/false/no/off disables the managed `opencode serve` boot entirely.
# DEEPSEAPORT_OPENCODE_MANAGED=1
# Agent name to run messages with (default deepseaport-passthrough, the
# generated text-only minimal agent).
# DEEPSEAPORT_OPENCODE_AGENT=deepseaport-passthrough
# Per-request timeout in seconds (default 180, floor 1).
# DEEPSEAPORT_OPENCODE_TIMEOUT=180
# Control-plane identity headers on every serve request.
# DEEPSEAPORT_OPENCODE_CLIENT=cli
# DEEPSEAPORT_OPENCODE_PROJECT=global
# DEEPSEAPORT_OPENCODE_USER_AGENT=opencode/<cli version>
