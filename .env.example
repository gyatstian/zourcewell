# Export these in your shell or profile; nothing here reads a .env file.
#
# WARNING: every ZOURCEWELL_* var below is commented out ON PURPOSE. Per
# config.py a var with a real value overrides config.json, so an uncommented
# ZOURCEWELL_KEYS silently replaces your keys, ZOURCEWELL_PORT forces the
# port, and ZOURCEWELL_LISTEN forces the bind. Uncomment only the ones you
# mean. An EMPTY var (`ZOURCEWELL_PORT=`) counts as unset and leaves
# config.json in charge, so `set -a; . .env` cannot silently revert a field to
# its built-in default.
# ZOURCEWELL_CONFIG=./config.json
# API key(s), comma separated; replaces config.json "keys". Leave it empty
# (or absent) to keep the config's keys; a list that parses to nothing is
# ignored with a warning. `"keys": []` in config.json means AUTH DISABLED on
# every endpoint.
# ZOURCEWELL_KEYS=sk-change-me
# ZOURCEWELL_PORT=5001
# true -> bind 0.0.0.0 (LAN-visible; the server prints a warning), false ->
# 127.0.0.1 only; unset or empty -> config.json decides.
# ZOURCEWELL_LISTEN=
# Single account (alternative to config.json; ZOURCEWELL_* preferred,
# DEEPSEEK_* kept as aliases)
# ZOURCEWELL_EMAIL=
# ZOURCEWELL_PASSWORD=
# ZOURCEWELL_TOKEN=
# DEEPSEEK_EMAIL=
# DEEPSEEK_PASSWORD=
# DEEPSEEK_TOKEN=
# ZOURCEWELL_ACTIVE_ACCOUNT=
# Provider selection (alternative to config.json)
# ZOURCEWELL_PROVIDER=deepseek
# ZOURCEWELL_PROVIDERS=
# Obscura overrides: a real path overrides config.json, an empty value
# (`OBSCURA_BIN=`) counts as unset and keeps the config.json value - the rule
# every ZOURCEWELL_* var above follows too.
# OBSCURA_BIN=
# OBSCURA_PROFILE=
# Browser / data dir
# ZOURCEWELL_BROWSER_BIN=auto
# ZOURCEWELL_BROWSER_HEADLESS=
# ZOURCEWELL_DATA=./data
# Advanced host overrides (default pinned hosts preserved)
# ZOURCEWELL_HOST=chat.deepseek.com
# ZOURCEWELL_BASE=https://chat.deepseek.com
# ZOURCEWELL_CHAT_HOME=https://chat.deepseek.com/
# ZOURCEWELL_WASM_URL=
# ZOURCEWELL_WASM_NAME=
# Qwen overrides
# ZOURCEWELL_QWEN_HOST=chat.qwen.ai
# ZOURCEWELL_QWEN_BASE=https://chat.qwen.ai
# ZOURCEWELL_QWEN_VERSION=0.2.91
# ZOURCEWELL_QWEN_COMPLETION_VERSION=2.1
# ZOURCEWELL_QWEN_NO_BEARER=
# Behaviour overrides (mirror config.json; 1/true/yes/on = true)
# ZOURCEWELL_ENABLE_TOOLS=1
# ZOURCEWELL_WARMUP_ON_STARTUP=1
# ZOURCEWELL_AUTO_DELETE_SESSION=1
# ZOURCEWELL_MAX_RETRIES=1
# ZOURCEWELL_PARALLEL_FETCH=1
# Tool-call argument cap in characters (default 200000; larger values let
# coders write bigger files in one call, at the cost of more memory).
# ZOURCEWELL_MAX_ARGS_CHARS=200000
# More forgiving toolcalls: repair common model markup slips (pipe/space/
# HTML-escaped DSML markers, smart attribute delimiters, missing-name/param
# inference for single-tool harnesses, JSON invoke bodies). Default off.
# ZOURCEWELL_FORGIVING_TOOLCALLS=1
# Cap on JSON objects the tool parser scans for a bare name+arguments call
# (default 40; also bounds the forgiving bucket's total-call scan).
# ZOURCEWELL_MAX_BARE_OBJECTS=40
# ZOURCEWELL_USE_MULTIPLE_ACCOUNTS=1
# ZOURCEWELL_LOG_LEVEL=INFO
# ZOURCEWELL_STREAM_MODE=live
# ZOURCEWELL_CHAT_MODEL=deepseek-flash
# Custom text wrapped around every prompt (multi-line ok; "" disables).
# ZOURCEWELL_ENABLE_APPEND=1
# ZOURCEWELL_APPEND_TOP=
# ZOURCEWELL_APPEND_BOTTOM=
# Dry run echo carries the printed raw + formatted prompt (1/true/yes/on)
# ZOURCEWELL_SEND_DRY_RUN_TO_FRONTEND=1
# --- opencode (local CLI) provider: no account, no token, no WAF ---
# Serve base URL. Unset = boot/reuse a managed isolated `opencode serve`;
# set it to use your own instance as-is (this also opts out of the managed boot).
# ZOURCEWELL_OPENCODE_BASE=http://127.0.0.1:4096
# Session working directory for tool execution (sent as location.directory in
# the session create body); unset = the zourcewell process cwd. Set it when
# the harness runs elsewhere.
# ZOURCEWELL_OPENCODE_WORKDIR=
# HTTP basic auth against the serve instance (managed child gets an
# ephemeral password of its own). Username default opencode, password "".
# ZOURCEWELL_OPENCODE_USERNAME=opencode
# ZOURCEWELL_OPENCODE_PASSWORD=
# 0/false/no/off disables the managed `opencode serve` boot entirely.
# ZOURCEWELL_OPENCODE_MANAGED=1
# Agent name to run messages with (default zourcewell-passthrough, the
# generated text-only minimal agent).
# ZOURCEWELL_OPENCODE_AGENT=zourcewell-passthrough
# Per-request timeout in seconds (default 180, floor 1).
# ZOURCEWELL_OPENCODE_TIMEOUT=180
# Control-plane identity headers on every serve request.
# ZOURCEWELL_OPENCODE_CLIENT=cli
# ZOURCEWELL_OPENCODE_PROJECT=global
# ZOURCEWELL_OPENCODE_USER_AGENT=opencode/<cli version>
